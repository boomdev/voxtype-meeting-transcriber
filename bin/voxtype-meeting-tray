class SubprocessLimitError(Exception):
    def __init__(self, kind: str, stdout: bytes = b"", stderr: bytes = b""):
        self.kind = kind
        self.stdout = stdout
        self.stderr = stderr
        if kind == "overflow":
            super().__init__("subprocess output exceeds protocol maximum")
        else:
            super().__init__("subprocess timed out")


def emit(value: dict, code: int = 0) -> int:
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))
    return code


def _set_nonblocking(stream) -> None:
    fd = stream.fileno()
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)


def _kill_process_group(proc: subprocess.Popen, grace: float = SUBPROCESS_KILL_GRACE_SECS) -> None:
    if proc.pid is None:
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            break
        try:
            proc.wait(timeout=grace)
            return
        except subprocess.TimeoutExpired:
            continue
    try:
        proc.wait(timeout=grace)
    except (subprocess.TimeoutExpired, ChildProcessError):
        pass


def run_capped(
    command: list[str],
    *,
    timeout: float,
    max_bytes: int = SUBPROCESS_MAX_BYTES,
) -> subprocess.CompletedProcess[str]:
    proc = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    stdout_stream = proc.stdout
    stderr_stream = proc.stderr
    if stdout_stream is None or stderr_stream is None:
        _kill_process_group(proc)
        raise OSError("subprocess pipes were not created")
    _set_nonblocking(stdout_stream)
    _set_nonblocking(stderr_stream)
    out = bytearray()
    err = bytearray()
    open_streams = {stdout_stream, stderr_stream}
    overflow = False
    deadline = time.monotonic() + timeout
    try:
        while open_streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _kill_process_group(proc)
                raise subprocess.TimeoutExpired(
                    command, timeout, output=bytes(out), stderr=bytes(err)
                )
            wait = remaining if proc.poll() is None else min(remaining, 0.05)
            ready, _, _ = select.select(list(open_streams), [], [], wait)
            if not ready:
                if proc.poll() is not None:
                    drained = False
                    for stream in list(open_streams):
                        try:
                            leftover = os.read(stream.fileno(), 4096)
                        except (BlockingIOError, OSError):
                            leftover = b""
                        if not leftover:
                            open_streams.discard(stream)
                            continue
                        drained = True
                        buf = out if stream is stdout_stream else err
                        room = max_bytes - len(buf)
                        if room < len(leftover):
                            if room > 0:
                                buf.extend(leftover[:room])
                            overflow = True
                            _kill_process_group(proc)
                            open_streams.clear()
                            break
                        buf.extend(leftover)
                    if not drained and not overflow:
                        open_streams.clear()
                continue
            for stream in ready:
                try:
                    chunk = os.read(stream.fileno(), 4096)
                except BlockingIOError:
                    continue
                buf = out if stream is stdout_stream else err
                if not chunk:
                    open_streams.discard(stream)
                    continue
                room = max_bytes - len(buf)
                if room < len(chunk):
                    if room > 0:
                        buf.extend(chunk[:room])
                    overflow = True
                    _kill_process_group(proc)
                    open_streams.clear()
                    break
                buf.extend(chunk)
        wait_left = max(0.05, deadline - time.monotonic())
        try:
            returncode = proc.wait(timeout=wait_left)
        except subprocess.TimeoutExpired:
            _kill_process_group(proc)
            raise subprocess.TimeoutExpired(
                command, timeout, output=bytes(out), stderr=bytes(err)
            ) from None
        if overflow:
            raise SubprocessLimitError("overflow", bytes(out), bytes(err))
        return subprocess.CompletedProcess(
            command,
            returncode,
            out.decode("utf-8", errors="replace"),
            err.decode("utf-8", errors="replace"),
        )
    finally:
        for stream in (stdout_stream, stderr_stream):
            try:
                stream.close()
            except OSError:
                pass
        if proc.poll() is None:
            _kill_process_group(proc)

def runtime_socket() -> Path:
    root = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(root) / "voxtype-meeting-service" / "voxtype-meeting-service.sock"

def _set_deadline_timeout(client: socket.socket, deadline: float) -> None:
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError("control socket deadline exceeded")
    client.settimeout(remaining)


def request(payload: dict) -> dict:
    try:
        encoded = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
    except (TypeError, ValueError) as exc:
        return {"ok": False, "error": f"Could not contact the meeting service: {exc}"}
    if len(encoded) > CONTROL_MAX_LINE_BYTES:
        return {"ok": False, "error": "Control request exceeds protocol maximum."}
    path = runtime_socket()
    if not path.exists():
        return {"ok": False, "error": "Voxtype Meeting Service is not running."}
    try:
        deadline = time.monotonic() + CONTROL_IDLE_TIMEOUT_SECS
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            _set_deadline_timeout(client, deadline)
            client.connect(str(path))
            _set_deadline_timeout(client, deadline)
            client.sendall(encoded + b"\n")
            data = bytearray()
            while True:
                _set_deadline_timeout(client, deadline)
                room = CONTROL_MAX_LINE_BYTES - len(data)
                block = client.recv(min(4096, room + 1))
                if not block:
                    break
                newline = block.find(b"\n")
                if newline != -1:
                    if len(data) + newline > CONTROL_MAX_LINE_BYTES:
                        return {"ok": False, "error": "Control response exceeds protocol maximum."}
                    data.extend(block[:newline])
                    break
                if len(data) + len(block) > CONTROL_MAX_LINE_BYTES:
                    return {"ok": False, "error": "Control response exceeds protocol maximum."}
                data.extend(block)
        return json.loads(bytes(data))
    except (OSError, ValueError, TimeoutError) as exc:
        return {"ok": False, "error": f"Could not contact the meeting service: {exc}"}


def _leaf_name(path: Path) -> str:
    name = Path(path).name
    if not name or name in (".", "..") or "/" in name or "\x00" in name:
        raise OSError("invalid file name")
    return name


def _absolute_parts(path: Path) -> list[str]:
    expanded = Path(os.path.expandvars(os.path.expanduser(str(path))))
    if not expanded.is_absolute():
        expanded = Path.cwd() / expanded
    parts = []
    for part in expanded.parts:
        if part in ("/", "", "."):
            continue
        if part == "..":
            raise OSError("path traversal is not allowed")
        if "/" in part or "\x00" in part:
            raise OSError("invalid path component")
        parts.append(part)
    return parts


def _assert_dir(st: os.stat_result, *, final: bool) -> None:
    if not stat.S_ISDIR(st.st_mode):
        raise OSError(errno.ENOTDIR, "not a directory")
    euid = os.geteuid()
    if final:
        if st.st_uid != euid:
            raise OSError(errno.EPERM, "directory is not owned by the current user")
        if st.st_mode & 0o002:
            raise OSError(errno.EPERM, "directory is world-writable")
        return
    if st.st_uid not in (0, euid):
        raise OSError(errno.EPERM, "untrusted directory in path")


def _assert_owned_regular_file(st: os.stat_result, max_bytes: int) -> None:
    if not stat.S_ISREG(st.st_mode):
        raise OSError(errno.EPERM, "not a regular file")
    if st.st_uid != os.geteuid():
        raise OSError(errno.EPERM, "file is not owned by the current user")
    if st.st_mode & 0o002:
        raise OSError(errno.EPERM, "file is world-writable")
    if st.st_size > max_bytes:
        raise OSError("file exceeds size limit")


def _open_dir_component(dirfd: int, name: str, *, create: bool, final: bool) -> int:
    try:
        fd = os.open(name, _DIR_NOFOLLOW_FLAGS, dir_fd=dirfd)
    except FileNotFoundError:
        if not create:
            raise
        try:
            os.mkdir(name, 0o700, dir_fd=dirfd)
        except FileExistsError:
            pass
        fd = os.open(name, _DIR_NOFOLLOW_FLAGS, dir_fd=dirfd)
    except OSError as exc:
        if exc.errno != errno.ELOOP:
            raise
        lst = os.lstat(name, dir_fd=dirfd)
        if not stat.S_ISLNK(lst.st_mode) or lst.st_uid not in (0, os.geteuid()):
            raise OSError(exc.errno, "refusing to follow symbolic link") from exc
        fd = os.open(name, _DIR_FLAGS, dir_fd=dirfd)
    try:
        _assert_dir(os.fstat(fd), final=final)
    except Exception:
        os.close(fd)
        raise
    return fd


def _open_held_dir(path: Path, *, create: bool) -> int:
    parts = _absolute_parts(path)
    fd = os.open("/", _DIR_FLAGS)
    try:
        for index, part in enumerate(parts):
            next_fd = _open_dir_component(fd, part, create=create, final=index == len(parts) - 1)
            os.close(fd)
            fd = next_fd
        if not parts:
            _assert_dir(os.fstat(fd), final=True)
        return fd
    except Exception:
        os.close(fd)
        raise


@contextlib.contextmanager
def held_directory(path: Path, *, create: bool = False):
    fd = _open_held_dir(Path(path), create=create)
    try:
        yield fd
    finally:
        os.close(fd)


def _read_fd(fd: int, max_bytes: int) -> bytes:
    data = bytearray()
    while True:
        chunk = os.read(fd, min(65536, max(1, max_bytes - len(data) + 1)))
        if not chunk:
            break
        data.extend(chunk)
        if len(data) > max_bytes:
            raise OSError("file exceeds size limit")
    return bytes(data)


def _write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError("short write")
        view = view[written:]


def _copy_fd(src_fd: int, dst_fd: int, max_bytes: int) -> None:
    copied = 0
    while True:
        chunk = os.read(src_fd, 65536)
        if not chunk:
            break
        copied += len(chunk)
        if copied > max_bytes:
            raise OSError("file exceeds size limit")
        _write_all(dst_fd, chunk)


def _exclusive_tmp(dirfd: int, prefix: str) -> tuple[int, str]:
    for _ in range(16):
        name = f".{prefix}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
        try:
            fd = os.open(name, _FILE_WRITE_FLAGS, 0o600, dir_fd=dirfd)
        except FileExistsError:
            continue
        try:
            os.fchmod(fd, 0o600)
        except OSError:
            os.close(fd)
            try:
                os.unlink(name, dir_fd=dirfd)
            except OSError:
                pass
            raise
        return fd, name
    raise OSError("could not create a private temporary file")


def read_private_file(path: Path, *, max_bytes: int) -> bytes:
    path = Path(path)
    with held_directory(path.parent, create=False) as dirfd:
        fd = os.open(_leaf_name(path), _FILE_READ_FLAGS, dir_fd=dirfd)
        try:
            _assert_owned_regular_file(os.fstat(fd), max_bytes)
            return _read_fd(fd, max_bytes)
        finally:
            os.close(fd)


def write_private_file(path: Path, data: bytes, *, max_bytes: int, create_dir: bool = False) -> None:
    if len(data) > max_bytes:
        raise OSError("payload exceeds size limit")
    path = Path(path)
    name = _leaf_name(path)
    with held_directory(path.parent, create=create_dir) as dirfd:
        fd, tmp_name = _exclusive_tmp(dirfd, name)
        try:
            try:
                _write_all(fd, data)
                os.fsync(fd)
            finally:
                os.close(fd)
            os.rename(tmp_name, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
            os.fsync(dirfd)
        except Exception:
            try:
                os.unlink(tmp_name, dir_fd=dirfd)
            except OSError:
                pass
            raise


def copy_private_file(source: Path, dest: Path, *, max_bytes: int) -> Path:
    source = Path(source)
    dest = Path(dest)
    with held_directory(source.parent, create=False) as src_dir:
        src_fd = os.open(_leaf_name(source), _FILE_READ_FLAGS, dir_fd=src_dir)
        try:
            _assert_owned_regular_file(os.fstat(src_fd), max_bytes)
            with held_directory(dest.parent, create=True) as dst_dir:
                tmp_fd, tmp_name = _exclusive_tmp(dst_dir, _leaf_name(dest))
                try:
                    try:
                        _copy_fd(src_fd, tmp_fd, max_bytes)
                        os.fsync(tmp_fd)
                    finally:
                        os.close(tmp_fd)
                    dest_name = _publish_exclusive(dst_dir, tmp_name, dest)
                    return dest.parent / dest_name
                except Exception:
                    try:
                        os.unlink(tmp_name, dir_fd=dst_dir)
                    except OSError:
                        pass
                    raise
        finally:
            os.close(src_fd)


def _publish_exclusive(dirfd: int, tmp_name: str, dest: Path) -> str:
    stem, suffix = dest.stem, dest.suffix
    candidates = [_leaf_name(dest)]
    for index in range(2, 1000):
        candidates.append(_leaf_name(Path(f"{stem}-{index}{suffix}")))
    for name in candidates:
        try:
            os.link(tmp_name, name, src_dir_fd=dirfd, dst_dir_fd=dirfd, follow_symlinks=False)
        except FileExistsError:
            continue
        os.unlink(tmp_name, dir_fd=dirfd)
        os.fsync(dirfd)
        return name
    raise OSError("could not choose an exclusive destination name")


def owned_regular_file(path: Path, *, max_bytes: int) -> bool:
    try:
        path = Path(path)
        with held_directory(path.parent, create=False) as dirfd:
            fd = os.open(_leaf_name(path), _FILE_READ_FLAGS, dir_fd=dirfd)
            try:
                _assert_owned_regular_file(os.fstat(fd), max_bytes)
            finally:
                os.close(fd)
        return True
    except OSError:
        return False


def voxtype_config_path() -> Path:
    return Path.home() / ".config/voxtype/config.toml"

def normalize_language_code(value) -> str:
    if isinstance(value, (list, tuple)):
        value = value[0] if value else "en"
    code = str(value or "en").strip().lower()
    if "," in code:
        code = code.split(",", 1)[0].strip()
    return code or "en"

def voxtype_summary() -> tuple[str, str, str]:
    try:
        raw = read_private_file(voxtype_config_path(), max_bytes=CONFIG_MAX_BYTES)
        cfg = tomllib.loads(raw.decode("utf-8"))
        engine = str(cfg.get("engine") or "whisper")
        section = cfg.get(engine) if isinstance(cfg.get(engine), dict) else cfg.get("whisper", {})
        section = section or {}
        model = str(section.get("model") or "configured")
        return engine, model, normalize_language_code(section.get("language", "en"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        return "voxtype", "configured", "en"

def language_option(code: str) -> dict:
    value = str(code or "").strip().lower()
    return {"value": value, "label": value.upper()}

def moonshine_languages(model: str) -> list[str]:
    name = Path(model or "").name.lower()
    codes = []
    if any(token in name for token in ("ja", "japanese")):
        codes.append("ja")
    if any(token in name for token in ("zh", "cmn", "chinese", "mandarin")):
        codes.append("zh")
    if any(token in name for token in ("ko", "korean")):
        codes.append("ko")
    if any(token in name for token in ("ar", "arabic")):
        codes.append("ar")
    return codes or ["en"]

def language_codes_for(engine: str, model: str) -> list[str]:
    kind = (engine or "whisper").lower()
    if kind in ("whisper", "voxtype"):
        return list(VOXTYPE_WHISPER_LANGUAGES)
    if kind == "sensevoice":
        return list(SENSEVOICE_LANGUAGES)
    if kind == "cohere":
        return list(COHERE_LANGUAGES)
    if kind == "paraformer":
        return list(PARAFORMER_LANGUAGES)
    if kind == "moonshine":
        return moonshine_languages(model)
    if kind == "parakeet":
        return ["en"]
    if kind == "dolphin":
        return list(DOLPHIN_LANGUAGES)
    if kind == "omnilingual":
        return ["auto", *WHISPER_LANGUAGES]
    return ["auto", "en"]

def available_languages(engine: str, model: str) -> list[dict]:
    seen = set()
    options = []
    for code in language_codes_for(engine, model):
        option = language_option(code)
        if not option["value"] or option["value"] in seen:
            continue
        seen.add(option["value"])
        options.append(option)
    return options

def apply_language_override(contents: str, engine: str, language: str) -> str:
    header = f"[{engine}]"
    quoted_header = f"[\"{engine}\"]"
    replacement = f'language = "{language}"'
    lines = contents.splitlines()
    in_section = False
    replaced = False
    insert_at = None
    for index, line in enumerate(lines):
        trimmed = line.strip()
        if trimmed.startswith("[") and trimmed.endswith("]"):
            if in_section and not replaced:
                insert_at = index
                break
            in_section = trimmed.lower() in (header.lower(), quoted_header.lower())
            if in_section:
                insert_at = index + 1
            continue
        lower = trimmed.lower()
        if in_section and lower.startswith("language") and lower[8:].lstrip().startswith("="):
            indent = line[: len(line) - len(line.lstrip())]
            lines[index] = f"{indent}{replacement}"
            replaced = True
            break
    if not replaced:
        if insert_at is not None:
            lines.insert(insert_at, replacement)
        else:
            if lines and lines[-1] != "":
                lines.append("")
            lines.append(header)
            lines.append(replacement)
    out = "\n".join(lines)
    if contents.endswith("\n"):
        out += "\n"
    return out


def voxtype_daemon_info() -> dict:
    info = {}
    try:
        shown = run_capped(
            ["systemctl", "--user", "show", "voxtype.service",
             "--property=MainPID,ActiveState,ActiveEnterTimestamp,NRestarts"],
            timeout=VOXTYPE_STATUS_TIMEOUT_SECS,
        )
        for line in shown.stdout.splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                info[key] = value.strip()
        if shown.returncode != 0:
            info["systemctlError"] = (shown.stderr or shown.stdout).strip()[:200]
    except Exception as exc:
        info["error"] = str(exc)
    try:
        status = run_capped(
            ["voxtype", "status", "--format", "json", "--extended"],
            timeout=VOXTYPE_STATUS_TIMEOUT_SECS,
        )
        parsed = json.loads(status.stdout.strip() or "{}")
        info["statusAlt"] = str(parsed.get("alt") or "")
        info["statusTooltip"] = str(parsed.get("tooltip") or "")[:180]
    except Exception as exc:
        info["statusError"] = str(exc)
    return info


_READY_STATUS = {"idle", "recording", "transcribing", "paused"}


def restart_voxtype_daemon() -> dict:
    result = {"attempted": True, "ok": False}
    try:
        proc = run_capped(
            ["systemctl", "--user", "restart", "voxtype.service"],
            timeout=VOXTYPE_RESTART_TIMEOUT_SECS,
        )
        result["returncode"] = proc.returncode
        if proc.returncode != 0:
            result["error"] = (proc.stderr or proc.stdout).strip()[:300] or f"systemctl exited {proc.returncode}"
            result["daemon"] = voxtype_daemon_info()
            return result
        deadline = time.monotonic() + VOXTYPE_RESTART_TIMEOUT_SECS
        last = {}
        while time.monotonic() < deadline:
            last = voxtype_daemon_info()
            alt = str(last.get("statusAlt") or "")
            if last.get("ActiveState") == "active" and alt in _READY_STATUS:
                result["ok"] = True
                result["daemon"] = last
                return result
            time.sleep(0.3)
        result["daemon"] = last
        result["error"] = "Voxtype daemon restarted but was not ready in time"
        return result
    except Exception as exc:
        result["error"] = str(exc)
        result["daemon"] = voxtype_daemon_info()
        return result


def set_voxtype_language(code: str) -> dict:
    language = normalize_language_code(code)
    path = voxtype_config_path()
    try:
        contents = read_private_file(path, max_bytes=CONFIG_MAX_BYTES).decode("utf-8")
    except FileNotFoundError:
        return {"ok": False, "error": "Voxtype configuration was not found."}
    except OSError as exc:
        return {"ok": False, "error": f"Could not read Voxtype configuration: {exc}"}
    except UnicodeDecodeError as exc:
        return {"ok": False, "error": f"Could not read Voxtype configuration: {exc}"}
    engine, model, current = voxtype_summary()
    name = Path(model or "").name.lower()
    if (name.endswith(".en") or ".en." in name) and language != "en":
        return {"ok": False, "error": "This Voxtype model is English-only."}
    allowed = {item["value"] for item in available_languages(engine, model)}
    if language not in allowed:
        return {"ok": False, "error": f"Language '{language}' is not available for the current Voxtype engine."}
    updated = apply_language_override(contents, engine, language)
    try:
        write_private_file(path, updated.encode("utf-8"), max_bytes=CONFIG_MAX_BYTES)
    except OSError as exc:
        return {"ok": False, "error": f"Could not update Voxtype language: {exc}"}
    _, _, after = voxtype_summary()
    if after == current and updated == contents:
        restart = {"ok": True}
    else:
        restart = restart_voxtype_daemon()
    if not restart.get("ok"):
        return {
            "ok": False,
            "error": restart.get("error") or "Could not restart the Voxtype daemon after changing language.",
            "language": language,
        }
    return {"ok": True, "message": "Voxtype language updated", "language": language, "engine": engine, "model": model}

def export_sidecar_path(session_dir: str | Path) -> Path:
    return Path(session_dir) / EXPORT_SIDECAR

def read_exported_path(session_dir: str) -> str:
    if not session_dir:
        return ""
    sidecar = export_sidecar_path(session_dir)
    try:
        payload = json.loads(read_private_file(sidecar, max_bytes=SIDECAR_MAX_BYTES).decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return ""
    path = str(payload.get("path") or "").strip()
    if not path:
        return ""
    return path if owned_regular_file(Path(path), max_bytes=TRANSCRIPT_MAX_BYTES) else ""

def write_exported_path(session_dir: str, path: Path) -> None:
    if not session_dir:
        return
    sidecar = export_sidecar_path(session_dir)
    payload = json.dumps({"path": str(path)}, ensure_ascii=False).encode("utf-8")
    write_private_file(sidecar, payload, max_bytes=SIDECAR_MAX_BYTES, create_dir=False)

def normalize_session(item: dict) -> dict:
    session_dir = str(item.get("session_dir") or "")
    return {
        "id": str(item.get("id") or ""), "title": str(item.get("title") or "Meeting"),
        "startedAt": str(item.get("started_at") or ""), "endedAt": str(item.get("ended_at") or ""),
        "durationSecs": int(item.get("duration_secs") or 0), "status": str(item.get("ui_status") or item.get("state") or "unknown"),
        "chunkCount": int(item.get("chunk_count") or 0), "storagePath": session_dir,
        "transcriptPath": str(item.get("transcript_md") or ""), "transcriptExists": item.get("transcript_exists") is True,
        "exportedPath": read_exported_path(session_dir),
    }

def device_options(items: list[dict], configured: str) -> list[dict]:
    options = [{"value": "default", "label": "System default"}]
    seen = {"default"}
    for item in items:
        device_id = str(item.get("id") or "").strip()
        if not device_id or device_id in seen:
            continue
        label = str(item.get("description") or device_id).strip()
        options.append({"value": device_id, "label": label})
        seen.add(device_id)
    if configured and configured not in seen:
        options.append({"value": configured, "label": configured})
    return options

def snapshot() -> dict:
    state = request({"op": "get_state"})
    if not state.get("ok"):
        engine, model, language = voxtype_summary()
        return {"ok": True, "installed": shutil.which("voxtype-meeting-service") is not None,
                "available": False, "state": "idle", "active": None, "recent": [],
                "options": {"engine": engine, "model": model, "language": language,
                            "availableLanguages": available_languages(engine, model)},
                "configPath": str(Path.home()/".config/voxtype-meeting-service/config.toml"),
                "error": state.get("error", "Meeting service unavailable")}
    recording = state.get("recording") or {}
    active = None
    if recording.get("active") and recording.get("session_id"):
        detail = request({"op": "get_session", "session_id": recording["session_id"]})
        active = normalize_session(detail.get("session") or {"id": recording["session_id"], "started_at": recording.get("started_at")})
    config = request({"op": "get_config"})
    audio = ((config.get("config") or {}).get("audio") or {}) if config.get("ok") else {}
    devices = request({"op": "list_devices"})
    mic_device = str(audio.get("microphone", "default"))
    output_device = str(audio.get("system_output", "default"))
    engine, model, language = voxtype_summary()
    paused = recording.get("paused") is True
    current_state = "paused" if paused else "recording" if recording.get("active") else "idle"
    return {"ok": True, "installed": True, "available": True, "state": current_state,
            "active": active, "recent": [normalize_session(x) for x in state.get("recent_sessions", [])],
            "options": {"source": audio.get("source", "both"), "retainAudio": audio.get("retain_audio", False),
                        "micDevice": mic_device, "loopbackDevice": output_device,
                        "micDevices": device_options(devices.get("microphones", []), mic_device),
                        "outputDevices": device_options(devices.get("outputs", []), output_device),
                        "engine": engine, "model": model, "language": language,
                        "availableLanguages": available_languages(engine, model)},
            "configPath": str(Path.home()/".config/voxtype-meeting-service/config.toml"), "restartRequired": False, "error": ""}

def action(name: str, title: str, language: str = "") -> dict:
    op = {"start": "start_recording", "stop": "stop_recording", "pause": "pause_recording", "resume": "resume_recording"}[name]
    payload = {"op": op}
    if name == "start" and language.strip():
        payload["language"] = language.strip()
    result = request(payload)
    if not result.get("ok"): return result
    if name == "start" and title.strip() and result.get("session_id"):
        renamed = request({"op": "rename_session", "session_id": result["session_id"], "title": title.strip()})
        if not renamed.get("ok"): return renamed
    labels = {"start": "Meeting started", "stop": "Meeting stopped", "pause": "Meeting paused", "resume": "Meeting resumed"}
    return {**result, "ok": True, "message": labels[name]}

def home_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value)))

def safe_name(title: str, started: str) -> str:
    try: stamp = dt.datetime.fromisoformat(started.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d_%H-%M")
    except ValueError: stamp = "meeting"
    cleaned = "-".join("".join(c for c in title.lower() if c.isalnum() or c in " -_").split()) or "meeting"
    return f"{stamp}_{cleaned[:80]}.md"

def find_session(meeting_id: str) -> dict:
    sessions = request({"op": "list_sessions"})
    if not sessions.get("ok"): return sessions
    items = sessions.get("sessions") or []
    selected = items[0] if meeting_id == "latest" and items else next((x for x in items if x.get("id") == meeting_id), None)
    if not selected:
        return {"ok": False, "error": "No matching meeting was found."}
    return {"ok": True, "session": selected}

def open_path(path: Path) -> dict | None:
    if not owned_regular_file(path, max_bytes=TRANSCRIPT_MAX_BYTES):
        return {"ok": False, "error": "The exported transcript is no longer on disk.", "path": str(path)}
    opener = shutil.which("omarchy-launch-editor") or shutil.which("xdg-open")
    if not opener:
        return {"ok": False, "error": "Could not open the transcript because no editor launcher is available.", "path": str(path)}
    try:
        subprocess.Popen(
            [opener, str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        return {"ok": False, "error": f"Could not open the transcript: {exc}", "path": str(path)}
    return None

def export_meeting(meeting_id: str, directory: str, open_after: bool) -> dict:
    found = find_session(meeting_id)
    if not found.get("ok"): return found
    selected = found["session"]
    source = Path(str(selected.get("transcript_md") or ""))
    if not source.name:
        return {"ok": False, "error": "The transcript is still being prepared."}
    target_dir = home_path(directory)
    target = target_dir / safe_name(str(selected.get("title") or "Meeting"), str(selected.get("started_at") or ""))
    try:
        written = copy_private_file(source, target, max_bytes=TRANSCRIPT_MAX_BYTES)
    except FileNotFoundError:
        return {"ok": False, "error": "The transcript is still being prepared."}
    except OSError as exc:
        return {"ok": False, "error": f"Could not export the transcript: {exc}"}
    write_exported_path(str(selected.get("session_dir") or ""), written)
    if open_after:
        failed = open_path(written)
        if failed: return {**failed, "message": "Transcript exported"}
    return {"ok": True, "message": "Transcript exported", "path": str(written), "meetingId": selected.get("id")}

def open_meeting(meeting_id: str) -> dict:
    found = find_session(meeting_id)
    if not found.get("ok"): return found
    selected = found["session"]
    exported = read_exported_path(str(selected.get("session_dir") or ""))
    if not exported:
        return {"ok": False, "error": "This transcript has not been exported yet."}
    failed = open_path(Path(exported))
    if failed: return failed
    return {"ok": True, "message": "Transcript opened", "path": exported, "meetingId": selected.get("id")}

def open_directory(path: Path) -> dict | None:
    command = folder_opener_command(path)
    if not command:
        return {"ok": False, "error": "Could not open the folder because no file manager is available.", "path": str(path)}
    try:
        subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        return {"ok": False, "error": f"Could not open the folder: {exc}", "path": str(path)}
    return None

def folder_opener_command(path: Path) -> list[str] | None:
    uwsm = shutil.which("uwsm-app")
    nautilus = shutil.which("nautilus")
    if uwsm and nautilus:
        return [uwsm, "--", nautilus, "--new-window", str(path)]
    if nautilus:
        return [nautilus, "--new-window", str(path)]
    xdg = shutil.which("xdg-open")
    if xdg:
        return [xdg, str(path)]
    return None

def open_export_folder(directory: str) -> dict:
    target = home_path(directory)
    try:
        with held_directory(target, create=True):
            pass
    except OSError as exc:
        return {"ok": False, "error": f"Could not open the folder: {exc}", "path": str(target)}
    failed = open_directory(target)
    if failed:
        return failed
    return {"ok": True, "message": "Transcripts folder opened", "path": str(target)}

def save_options(raw: str) -> dict:
    try: values = json.loads(raw)
    except ValueError as exc: return {"ok": False, "error": f"Invalid meeting settings: {exc}"}
    audio = {"source": values.get("source", "both"), "retain_audio": values.get("retainAudio", False),
             "microphone": values.get("micDevice", "default"), "system_output": values.get("loopbackDevice", "default")}
    result = request({"op": "update_config", "config": {"audio": audio}})
    return {**result, "message": "Meeting options saved", "restartRequired": False} if result.get("ok") else result

def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(); sub = root.add_subparsers(dest="command", required=True)
    sub.add_parser("snapshot")
    act = sub.add_parser("action")
    act.add_argument("name", choices=["start","stop","pause","resume"])
    act.add_argument("--title", default="")
    act.add_argument("--language", default="")
    exp = sub.add_parser("export")
    exp.add_argument("meeting_id")
    exp.add_argument("--directory", required=True)
    exp.add_argument("--open", action="store_true", dest="open_after")
    opened = sub.add_parser("open")
    opened.add_argument("meeting_id")
    folder = sub.add_parser("open-folder")
    folder.add_argument("--directory", required=True)
    settings = sub.add_parser("settings"); settings.add_argument("json")
    lang = sub.add_parser("language"); lang.add_argument("code")
    sub.add_parser("restart"); return root

def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "snapshot": result = snapshot()
        elif args.command == "action": result = action(args.name, args.title, args.language)
        elif args.command == "export": result = export_meeting(args.meeting_id, args.directory, args.open_after)
        elif args.command == "open": result = open_meeting(args.meeting_id)
        elif args.command == "open-folder": result = open_export_folder(args.directory)
        elif args.command == "settings": result = save_options(args.json)
        elif args.command == "language": result = set_voxtype_language(args.code)
        else: result = {"ok": False, "error": "The meeting service restarts automatically."}
        return emit(result, 0 if result.get("ok") else 1)
    except Exception as exc: return emit({"ok": False, "error": f"Unexpected helper error: {exc}"}, 1)

if __name__ == "__main__": raise SystemExit(main())
