APP = "Voxtype Meeting Transcriber"
EXPORT_SIDECAR = "export.json"
CONTROL_IDLE_TIMEOUT_SECS = 30
CONTROL_MAX_LINE_BYTES = 64 * 1024
SUBPROCESS_MAX_BYTES = 64 * 1024
SUBPROCESS_KILL_GRACE_SECS = 2
VOXTYPE_STATUS_TIMEOUT_SECS = 3
VOXTYPE_RESTART_TIMEOUT_SECS = 45
CONFIG_MAX_BYTES = 1024 * 1024
SIDECAR_MAX_BYTES = 64 * 1024
TRANSCRIPT_MAX_BYTES = 32 * 1024 * 1024
_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NONBLOCK
_DIR_NOFOLLOW_FLAGS = _DIR_FLAGS | os.O_NOFOLLOW
_FILE_READ_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
_FILE_WRITE_FLAGS = (
    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
)

